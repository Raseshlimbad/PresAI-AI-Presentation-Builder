model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId            String?   @unique  // Made optional for non-Clerk auth
  name               String
  email              String    @unique
  username           String?   @unique
  password           String?   // Added for normal auth
  passwordSalt       String?   // Added for password security
  passwordResetToken String?   // Added for password reset functionality
  resetTokenExpiry   DateTime? // Added for token expiration
  profileImage       String?
  subscription       Boolean?  @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime  @default(now())
  authMethod         String?   @default("email")
  lemonSqueezyApiKey String?
  storeID            String?
  webhookSecret      String?

  Projects          Project[] @relation("OwnedProjects")
  PurchasedProjects Project[] @relation("PurchasedProjects")
}

// Project #########################################################################################################################################
model Project {
  id         String   @id @default(cuid())
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  slides     Json?
  userId     String   @db.Uuid
  outlines   String[]
  isDeleted  Boolean  @default(false)
  isSellable Boolean  @default(false)
  varientId  String?
  thumbnail  String?
  themeName  String   @default("light")

  User       User   @relation("OwnedProjects", fields: [userId], references: [id])
  Purchasers User[] @relation("PurchasedProjects")
}
